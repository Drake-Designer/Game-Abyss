{
  "profile": "django",
  "indent": 2,
  "max_line_length": 120,
  "format_css": true,
  "format_js": true,
  "ignore": "H006,H021,H030,H031",
  "exclude": "staticfiles/,__pycache__/,.venv/,node_modules/",
  "extension": "html",
  "lint_inline_tags": true,
  "close_void_tags": false,
  "max_blank_lines": 1,
  "preserve_blank_lines": false,
  "require_pragma": false,
  "linter_output_format": "{filename}:{line}: {code} {message}"
}
